{
  "hosting": {
    "public": "frontend/build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "errorPage": "/notFound.html"
  },
  "functions": {
    "source": "backend",
    "runtime": "nodejs20"
  }
}